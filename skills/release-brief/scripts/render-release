#!/usr/bin/env python3
"""Render a release artifact as JSON, Markdown, or interactive print-to-PDF HTML."""
import argparse
import html
import json
import sys
from pathlib import Path

ASSETS = Path(__file__).resolve().parents[1] / "assets"


def read_artifact(path):
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    if data.get("schema_version") not in {"1.0", "1.1"} or not isinstance(data.get("entries"), list) or not isinstance(data.get("source"), dict):
        raise ValueError("input is not a supported release-brief artifact")
    return data


def cell(value):
    return str(value if value is not None else "—").replace("|", "\\|").replace("\n", " ")


def render_markdown(data):
    source, evidence = data["source"], data.get("evidence", {})
    release_name = source.get("target_tag") or source.get("target_ref") or source.get("target_sha", "")[:8]
    lines = [
        f"# {release_name}", "",
        f"> **Draft** for **{data.get('audience')}** from `{source.get('base_ref')}..{source.get('target_ref')}`. Git history does not establish deployment.",
    ]
    collaboration = data.get("collaboration", {})
    confidence = data.get("confidence", {})
    contributors = collaboration.get("contributors", [])
    if contributors:
        lines.extend(["", "## Collaboration and scope", "", f"- Contributors: {collaboration.get('contributor_count', len(contributors))}", f"- Commits: {data.get('summary', {}).get('commits', 0)}", f"- Commit span: {collaboration.get('commit_span_hours', 0)} hours", "- Commit counts describe provenance and coordination, not individual productivity.", ""])
        lines.extend([f"- {item.get('name')}: {item.get('commits')} commits across {item.get('files_touched')} files; {', '.join(item.get('categories', []))}" for item in contributors])
    if confidence.get("domains"):
        lines.extend(["", "## Release evidence matrix", ""])
        lines.extend([f"- **{item.get('label')} — {item.get('status')}**: {item.get('detail')}" for item in confidence["domains"]])
    groups = {}
    for entry in data.get("entries", []):
        if entry.get("included"):
            groups.setdefault(entry.get("category", "Changed"), []).append(entry)
    for category in ["Breaking", "Security", "Added", "Fixed", "Performance", "Documentation", "Changed", "Internal"]:
        if category not in groups:
            continue
        lines.extend(["", f"## {category}", ""])
        for entry in groups[category]:
            refs = ", ".join(f"`{ref}`" if ref.startswith("commit:") else ref for ref in entry.get("evidence_refs", []))
            uncertainty = f" **Review:** {entry['uncertainty']}" if entry.get("uncertainty") else ""
            lines.append(f"- {entry.get('title')} ({refs}){uncertainty}")
    lines.extend(["", "## Verification and deployment", ""])
    tests = evidence.get("tests", [])
    if tests:
        lines.extend([f"- Test — **{item.get('name')}**: {item.get('status')} ({item.get('evidence_ref') or 'no evidence reference'})" for item in tests])
    else:
        lines.append("- Tests: unknown; no records supplied.")
    deployment = evidence.get("deployment", {})
    lines.append(f"- Deployment: {deployment.get('status', 'unknown')} ({deployment.get('evidence_ref') or 'no evidence reference'})")
    rollback = evidence.get("rollback", {})
    lines.append(f"- Rollback: {rollback.get('status', 'unknown')} ({rollback.get('evidence_ref') or 'no evidence reference'})")
    lines.append(f"- Observability: {evidence.get('observability', {}).get('status', 'unknown')} ({evidence.get('observability', {}).get('evidence_ref') or 'no evidence reference'})")
    lines.append(f"- Rollout: {evidence.get('rollout', {}).get('status', 'unknown')} ({evidence.get('rollout', {}).get('evidence_ref') or 'no evidence reference'})")
    scans = evidence.get("security_scans", [])
    if scans:
        lines.extend(["", "## Security and supply chain", ""])
        lines.extend([f"- {scan.get('provider')} {scan.get('scope', 'scan')}: {scan.get('status')} ({scan.get('evidence_ref') or 'no evidence reference'})" for scan in scans])
        delta = confidence.get("security_delta", {})
        for field in ("introduced", "resolved", "remaining"):
            counts = delta.get(field, {})
            lines.append(f"- {field.title()}: " + ", ".join(f"{level} {counts.get(level, 0)}" for level in ("critical", "high", "medium", "low")))
    dependency = evidence.get("dependency_review", {})
    lines.append(f"- Dependency review: {dependency.get('status', 'unknown')}; {dependency.get('added', 0)} added, {dependency.get('updated', 0)} updated, {dependency.get('vulnerable_added', 0)} vulnerable added.")
    supply = evidence.get("supply_chain", {})
    lines.append("- Supply chain: " + ", ".join(f"{name} {supply.get(name, {}).get('status', 'unknown')}" for name in ("sbom", "provenance", "signature")))
    if data.get("risk_flags"):
        lines.extend(["", "## Review signals", ""] + [f"- **{item.get('severity')} · {item.get('kind')}** — {item.get('reason')}" for item in data["risk_flags"]])
    limitations = evidence.get("known_limitations", [])
    if limitations:
        lines.extend(["", "## Known limitations", ""] + [f"- {item}" for item in limitations])
    lines.extend(["", "## Evidence gaps", ""] + ([f"- {item}" for item in data.get("evidence_gaps", [])] or ["- None recorded."]))
    lines.extend(["", "## Range provenance", "", f"- Base: `{source.get('base_sha')}`", f"- Target: `{source.get('target_sha')}`", f"- Commits: {data.get('summary', {}).get('commits', 0)}", f"- Files: {data.get('summary', {}).get('changed_files', 0)}", f"- Working-tree entries at collection: {source.get('dirty_entries', 0)}", ""])
    return "\n".join(lines)


def render_html(data):
    template = (ASSETS / "release-report-template.html").read_text(encoding="utf-8")
    css = (ASSETS / "release-report.css").read_text(encoding="utf-8")
    script = (ASSETS / "release-report.js").read_text(encoding="utf-8")
    payload = json.dumps(data, separators=(",", ":")).replace("<", "\\u003c")
    title = html.escape(str(data["source"].get("target_tag") or data["source"].get("target_ref") or "Release brief"))
    return template.replace("/*__RELEASE_CSS__*/", css).replace("/*__RELEASE_JS__*/", script).replace("__RELEASE_DATA__", payload).replace("__RELEASE_TITLE__", title)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("artifact")
    parser.add_argument("--format", choices=["json", "markdown", "html"], default="markdown")
    parser.add_argument("--out")
    args = parser.parse_args(argv)
    data = read_artifact(args.artifact)
    rendered = json.dumps(data, indent=2) + "\n" if args.format == "json" else render_html(data) if args.format == "html" else render_markdown(data)
    if args.out:
        Path(args.out).write_text(rendered, encoding="utf-8")
        print(args.out)
    else:
        print(rendered, end="")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, json.JSONDecodeError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(2)
